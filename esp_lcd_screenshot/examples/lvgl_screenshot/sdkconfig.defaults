CONFIG_PARTITION_TABLE_CUSTOM=y

# LVGL renders into an RGB888 framebuffer (B,G,R in memory, matching ESP_COLOR_FOURCC_BGR24)
CONFIG_LV_COLOR_DEPTH_24=y
CONFIG_LV_FONT_MONTSERRAT_14=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000

# 240x240 RGB888 capture needs more RAM than internal DRAM.
CONFIG_SPIRAM=y
