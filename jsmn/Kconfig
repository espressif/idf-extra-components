menu "jsmn"


    config JSMN_PARENT_LINKS
        bool "Enable parent links"
        default n
        help
            You can access parent node of parsed json

    config JSMN_STRICT
        bool "Enable strict mode"
        default n
        help
            Accept exactly the JSON grammar of RFC 8259: separators are
            checked, primitives must be true, false, null or a number as the
            RFC spells it, strings may not contain raw control characters,
            the text must be UTF-8, and there is exactly one top-level value.
            A NUL byte inside the given length is an error, not an end of
            text marker. Without strict mode the tokenizer is permissive.

    config JSMN_STATIC
        bool "Declare JSMN API as static"
        default n
        help
            Declare JSMN API as static (instead of extern)

endmenu
