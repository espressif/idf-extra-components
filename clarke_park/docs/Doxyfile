# Set this to the header file you want
INPUT = \
    ../include/

# The output directory for the generated XML documentation
OUTPUT_DIRECTORY = doxygen_output

# Warning-related settings, it's recommended to keep them enabled
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_AS_ERROR = YES

# Other common settings
FULL_PATH_NAMES = YES
STRIP_FROM_PATH = ../
STRIP_FROM_INC_PATH = ../
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
EXPAND_ONLY_PREDEF     = YES
EXTRACT_ALL            = YES
# DOXYGEN makes the declarations guarded by a Kconfig option (the CORDIC
# API) visible in the generated reference. The other definitions come from the
# environment when the docs are built for a specific configuration.
PREDEFINED             = DOXYGEN $(ENV_DOXYGEN_DEFINES)

# The CORDIC API includes "driver/cordic.h" from ESP-IDF. Doxygen only needs to
# skip it (the declarations in the header are enough), so preprocessing is not
# allowed to fail on missing includes.
SEARCH_INCLUDES        = NO
HAVE_DOT = NO
GENERATE_XML    = YES
XML_OUTPUT      = xml
GENERATE_HTML   = NO
HAVE_DOT        = NO
GENERATE_LATEX  = NO
QUIET = YES
MARKDOWN_SUPPORT = YES