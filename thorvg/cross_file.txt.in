[binaries]
cpp = '${CMAKE_CXX_COMPILER}'
ar = '${CMAKE_CXX_COMPILER_AR}'
as = '${CMAKE_ASM_COMPILER}'
ranlib = '${CMAKE_CXX_COMPILER_RANLIB}'
ld = '${CMAKE_LINKER}'
strip = '${CMAKE_STRIP}'

[built-in options]
cpp_args = ['-D_GNU_SOURCE','-D__linux__','-Wno-format','-Wno-stringop-truncation',${MESON_CXX_FLAGS}]
cpp_link_args = [${MESON_LINKER_FLAGS}]

[properties]
skip_sanity_check = ${TVG_SKIP_MESON_SANITY_CHECK}

[host_machine]
system = 'esp-idf'
cpu_family = '${cpu_family}'
cpu = 'esp'
endian = 'little'
