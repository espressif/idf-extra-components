# Machine identity only. Volatile flags and options (cpp_args, cpp_link_args,
# threads, log, loaders) are passed as -D arguments to `meson setup` and
# `meson configure` instead: Meson honors machine-file [built-in options] only
# during the first setup, while -D arguments are re-applied on every
# reconfigure (see CMakeLists.txt).

[binaries]
cpp = '${CMAKE_CXX_COMPILER}'
ar = '${CMAKE_CXX_COMPILER_AR}'
as = '${CMAKE_ASM_COMPILER}'
ranlib = '${CMAKE_CXX_COMPILER_RANLIB}'
ld = '${CMAKE_LINKER}'
strip = '${CMAKE_STRIP}'

[properties]
skip_sanity_check = ${THORVG_SKIP_MESON_SANITY_CHECK}

[host_machine]
system = 'esp-idf'
cpu_family = '${cpu_family}'
cpu = 'esp'
endian = 'little'
